# Required: copy this file to .env and edit values before using Docker Compose.
# Do not commit .env. It contains Immich API keys.

# Immich target (tested/assumed against Immich 2.7.5 metadata search API)
IMMICH_URL=http://immich-server:2283

# One API key per Immich user/account configured in config.yaml.
# Create read-capable API keys in Immich and keep them private.
IMMICH_API_KEY_PAUL=replace-with-pauls-immich-api-key
IMMICH_API_KEY_WIFE=replace-with-wifes-immich-api-key

# Optional future Ollama naming settings. Ollama is not integrated in current milestones.
OLLAMA_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Output/debug-ish settings used by config.example.yaml.
# Keep MEMORY_ENGINE_OUTPUT_DIR=output unless docker-compose.yml is updated to mount a different path.
MEMORY_ENGINE_OUTPUT_DIR=output
MEMORY_ENGINE_ALBUM_PREFIX=Vorschlag: 
MEMORY_ENGINE_DRY_RUN_DEFAULT=true
MEMORY_ENGINE_DEBUG=false
MEMORY_ENGINE_DEBUG_DIR=output/debug
